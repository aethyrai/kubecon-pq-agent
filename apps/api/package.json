{
  "name": "@kubecon-pq-agent/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/**/*.test.js",
    "start": "node --import ./dist/otel.js dist/server.js",
    "dev": "tsc -p tsconfig.json && node --import ./dist/otel.js dist/server.js"
  },
  "dependencies": {
    "@elastic/elasticsearch": "9.2.0",
    "@hono/node-server": "2.1.6",
    "@kubecon-pq-agent/embeddings": "0.0.0",
    "@kubecon-pq-agent/es-client": "0.0.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.301.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-node": "0.301.0",
    "hono": "4.13.17",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0"
  }
}
