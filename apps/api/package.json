{
  "name": "@kubecon-pq-agent/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/**/*.test.js",
    "start": "node --import @kubecon-pq-agent/otel/register dist/server.js",
    "dev": "tsc -p tsconfig.json && node --import @kubecon-pq-agent/otel/register dist/server.js"
  },
  "dependencies": {
    "@elastic/elasticsearch": "9.2.0",
    "@hono/node-server": "2.1.6",
    "@kubecon-pq-agent/embeddings": "0.0.0",
    "@kubecon-pq-agent/es-client": "0.0.0",
    "@kubecon-pq-agent/otel": "0.0.0",
    "hono": "4.13.17",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0"
  }
}
